<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.21" />
    <ProjectReference Include="../../src/CubeShelf.Desktop/CubeShelf.Desktop.csproj" />
    <Content Include="../../src/CubeShelf.Desktop/Catalogs/*.json" Link="Catalogs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/CubeShelf.Desktop/games.json" Link="games.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
