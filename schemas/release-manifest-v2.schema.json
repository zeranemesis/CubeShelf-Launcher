{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zeranemesis/CubeShelf-Launcher/schemas/release-manifest-v2.schema.json",
  "title": "CubeShelf release manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "signature": { "type": ["string", "null"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architecture", "type", "url", "size", "sha256"],
        "properties": {
          "os": { "enum": ["windows", "linux", "macos"] },
          "architecture": { "enum": ["x64", "arm64"] },
          "type": { "enum": ["launcher", "runtime"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "minimumOsVersion": { "type": ["string", "null"] }
        }
      }
    }
  }
}
