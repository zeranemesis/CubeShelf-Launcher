{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zeranemesis/CubeShelf-Launcher/schemas/cubeshelf-mod-v1.schema.json",
  "title": "CubeShelf mod manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gameId", "modId", "version"],
  "properties": {
    "schema": { "const": 1 },
    "gameId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "modId": { "type": "integer", "minimum": 1 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "minimumUpdated": { "type": "integer", "minimum": 0, "default": 0 },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "incompatibleWith": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
