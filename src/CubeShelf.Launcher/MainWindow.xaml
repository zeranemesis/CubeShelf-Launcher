<Window x:Class="CubeShelf.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CubeShelf.Launcher.Controls"
        Title="CubeShelf" Width="1530" Height="930" MinWidth="1220" MinHeight="760"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen" Icon="Assets/Brand/gamecube_logo.png">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<!-- SIDEBAR -->
<Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
<DockPanel Margin="16">
<StackPanel DockPanel.Dock="Top">
<StackPanel Orientation="Horizontal" Margin="0,4,0,28"><Border Width="46" Height="46" CornerRadius="12" Background="#101524" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="4"><Image Source="Assets/Brand/gamecube_logo.png" Stretch="Uniform"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="CubeShelf" Foreground="{DynamicResource Text}" FontSize="23" FontWeight="Bold"/><TextBlock Text="GameCube Library" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></StackPanel>
<Button Content="{DynamicResource AppLibrary}" HorizontalContentAlignment="Left" Click="LibraryNav_Click"/>
<Button Content="{DynamicResource AppMods}" HorizontalContentAlignment="Left" Click="ModsNav_Click"/>
<Button Content="{DynamicResource AppDownloads}" HorizontalContentAlignment="Left" Click="DownloadsNav_Click"/>
<Button Content="{DynamicResource AppFavorites}" HorizontalContentAlignment="Left"/>
<Button Content="{DynamicResource AppSettings}" HorizontalContentAlignment="Left" Click="SettingsNav_Click"/>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource Queue}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="QueueSidebarText" Text="—" Foreground="{DynamicResource Text}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><TextBlock x:Name="SidebarSelectedGame" Text="CubeShelf" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="7,0,7,8"/><TextBlock Text="CubeShelf v0.6.7" Foreground="{DynamicResource Muted}" FontSize="11" Margin="7"/></StackPanel>
</DockPanel>
</Border>

<Grid Grid.Column="1" x:Name="MainContent">
<!-- LIBRARY -->
<Grid x:Name="LibraryView">
<Grid.RowDefinitions><RowDefinition Height="155"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="34,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource LibraryEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12"/><TextBlock Text="{DynamicResource LibraryTitle}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="34" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource LibrarySubtitle}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="15,10" Margin="4"><StackPanel><TextBlock Text="{DynamicResource Updates}" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="LibraryUpdatesText" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="15" Margin="0,3,0,0"/></StackPanel></Border><Button Content="{DynamicResource AddGame}" Click="AddGameButton_Click"/></StackPanel></Grid></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="GameGrid" Margin="26,22,26,30"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="GameCard_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="10"><Border Width="260" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="13"><StackPanel><Grid><Border Height="330" Background="#090C13" CornerRadius="11" ClipToBounds="True"><Image Source="{Binding LibraryCover}" Stretch="UniformToFill"/></Border><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Danger}" CornerRadius="10" Padding="9,5" Margin="8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GitHubUpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{DynamicResource UpdateBadge}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border></Grid><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="18" Margin="3,13,3,0"/><TextBlock Text="{Binding GitHubStatusText}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="3,5,3,0"/></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</Grid>

<!-- GAME -->
<Grid x:Name="GameView" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="28,14,28,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{DynamicResource BackLibrary}" Click="LibraryNav_Click"/><TextBlock x:Name="GameHeader" Grid.Column="1" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/><StackPanel Grid.Column="2" Orientation="Horizontal"><ComboBox x:Name="CoverVariantCombo" Style="{StaticResource ModernComboBox}" Width="190" SelectionChanged="CoverVariantCombo_SelectionChanged" DisplayMemberPath="Label" Margin="4"/><Button Content="{DynamicResource FlipCase}" Click="FlipCaseButton_Click"/></StackPanel></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,8,34,35">
<Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="20" Padding="30"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="5,0,40,0"><TextBlock Text="{DynamicResource SelectedGame}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="SelectedTitle" Foreground="{DynamicResource Text}" FontSize="54" FontWeight="ExtraBold" Margin="0,8,0,8" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,10"><Border Background="{DynamicResource Panel2}" CornerRadius="11" Padding="10,6" Margin="0,0,7,7"><TextBlock x:Name="SelectedYear" Foreground="{DynamicResource Text}"/></Border><Border Background="{DynamicResource Panel2}" CornerRadius="11" Padding="10,6" Margin="0,0,7,7"><TextBlock x:Name="SelectedGenre" Foreground="{DynamicResource Text}"/></Border><Border Background="{DynamicResource Panel2}" CornerRadius="11" Padding="10,6" Margin="0,0,7,7"><TextBlock x:Name="SelectedPlayers" Foreground="{DynamicResource Text}"/></Border><Border Background="{DynamicResource Panel2}" CornerRadius="11" Padding="10,6" Margin="0,0,7,7"><TextBlock x:Name="SelectedId" Foreground="{DynamicResource Text}"/></Border></WrapPanel><TextBlock x:Name="SelectedDescription" Foreground="{DynamicResource Text}" Opacity="0.82" FontSize="15" LineHeight="24" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="{DynamicResource Play}" Background="White" Foreground="#10141E" Click="PlayButton_Click"/><Button Content="{DynamicResource Mods}" Background="{DynamicResource Accent}" Click="OpenModsButton_Click"/></StackPanel></StackPanel><controls:GameCase3D x:Name="GameCase" Grid.Column="1" Width="465" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
<Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,9,0"><StackPanel><TextBlock Text="{DynamicResource GithubProject}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="GitHubRepoText" Foreground="{DynamicResource Text}" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="GitHubStatusText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="GitHubLocalStatusText" Foreground="{DynamicResource Text}" Opacity="0.78" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,13,0,0">
<Button x:Name="GitHubDownloadButton" Content="{DynamicResource DownloadProject}" Background="#2674D9" Click="GitHubDownloadButton_Click"/>
<Button x:Name="GitHubSourceButton" Content="{DynamicResource DownloadSource}" Click="DownloadRepositoryButton_Click"/>
<Button Content="{DynamicResource Check}" Click="CheckSelectedGameUpdateButton_Click"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
<Button Content="{DynamicResource DeleteSource}" Click="DeleteRepositoryButton_Click"/>
</StackPanel><TextBlock Text="{DynamicResource Changes}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,14,0,5"/><TextBlock x:Name="GitHubChangesText" Foreground="{DynamicResource Text}" Opacity="0.82" FontSize="12" TextWrapping="Wrap" MaxHeight="150"/></StackPanel></Border>
<Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="9,0,0,0"><StackPanel><TextBlock Text="{DynamicResource LocalInstall}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SelectedInstallStatus" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource Executable}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,3"/><TextBlock x:Name="ExecutablePathText" Foreground="{DynamicResource Text}" Opacity="0.75" TextWrapping="Wrap"/><Button Content="{DynamicResource PointExecutable}" HorizontalAlignment="Left" Click="ConfigureExecutableButton_Click" Margin="0,10,0,0"/><TextBlock Text="{DynamicResource DiscImage}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,3"/><TextBlock x:Name="DiscImagePathText" Foreground="{DynamicResource Text}" Opacity="0.75" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button Content="{DynamicResource ChooseDisc}" Click="ConfigureDiscImageButton_Click"/><Button Content="{DynamicResource Clear}" Click="ClearDiscImageButton_Click"/></StackPanel><TextBlock Text="{DynamicResource SupportedDiscs}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,14,0,4"/><TextBlock x:Name="DiscCompatibilityText" Foreground="{DynamicResource Text}" Opacity="0.75" TextWrapping="Wrap"/>
<WrapPanel Margin="0,14,0,0">
<Button Content="{DynamicResource DeleteRuntime}" Click="DeleteRuntimeButton_Click"/>
<Button Content="{DynamicResource DeleteGameData}" Click="DeleteGameDataButton_Click"/>
<Button Content="{DynamicResource DeleteAllGameFiles}" Click="DeleteAllGameFilesButton_Click"/>
</WrapPanel>
</StackPanel></Border>
</Grid></StackPanel></ScrollViewer>
</Grid>

<!-- MODS -->
<Grid x:Name="ModsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="28,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{DynamicResource BackGame}" Click="BackToGameButton_Click"/><StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock x:Name="ModsGameTitle" Foreground="{DynamicResource Text}" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="ModsSummaryText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="{DynamicResource UpdateAll}" Background="#2674D9" Click="UpdateAllModsButton_Click"/><Button Content="{DynamicResource RefreshGameBanana}" Click="RefreshModsButton_Click"/></StackPanel></Grid></Border>
<Grid Grid.Row="1" Margin="24,18,24,24"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBox x:Name="ModSearchBox" TextChanged="ModSearchBox_TextChanged"/><TextBlock Text="{DynamicResource SearchMod}" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ModSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ListBox x:Name="ModsList" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="ModsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="78" Height="78" CornerRadius="9" ClipToBounds="True" Background="#080B12"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding UpdateText}" Foreground="#F2B45F" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
<Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ModDetailTitle" Text="{DynamicResource SelectMod}" Foreground="{DynamicResource Text}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="ModDetailVersion" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource GameBananaOpen}" Click="OpenSelectedModGameBanana_Click"/></Grid><Border Height="360" Background="#090C13" CornerRadius="14" Margin="0,18,0,0" ClipToBounds="True"><Grid><Image x:Name="ModGalleryImage" Stretch="Uniform"/><Button Content="‹" Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Click="PreviousModImage_Click"/><Button Content="›" Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Click="NextModImage_Click"/><Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#BB090C13" CornerRadius="9" Padding="10,5" Margin="0,0,0,10"><TextBlock x:Name="ModGalleryCounter" Text="0 / 0" Foreground="White" FontSize="11"/></Border></Grid></Border><TextBlock Text="{DynamicResource Description}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,18,0,6"/><TextBlock x:Name="ModDetailDescription" Foreground="{DynamicResource Text}" Opacity="0.82" FontSize="14" LineHeight="22" TextWrapping="Wrap"/><Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource ModState}" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="ModDetailStatus" Foreground="{DynamicResource Text}" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{DynamicResource Priority}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="SelectedModPriorityBox" Width="66" Margin="8,0,0,0"/></StackPanel></Grid></Border><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Button x:Name="SelectedModInstallButton" Content="{DynamicResource Install}" Background="#2674D9" Click="InstallSelectedMod_Click"/><Button x:Name="SelectedModToggleButton" Content="{DynamicResource Enable}" Click="ToggleSelectedMod_Click"/><Button Content="{DynamicResource Delete}" Click="UninstallSelectedMod_Click"/></StackPanel><TextBlock x:Name="ModsStatusText" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/></StackPanel></ScrollViewer></Border>
</Grid></Grid>

<!-- DOWNLOADS -->
<Grid x:Name="DownloadsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel Margin="34,24" VerticalAlignment="Center"><TextBlock Text="{DynamicResource DownloadsEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11"/><TextBlock Text="{DynamicResource DownloadsTitle}" Foreground="{DynamicResource Text}" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource DownloadsSubtitle}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,6,0,0"/><Button Content="{DynamicResource ClearFinished}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearFinishedDownloads_Click"/></StackPanel></Border><ListBox x:Name="DownloadsList" Grid.Row="1" Margin="28,20,28,28" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0"><ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="10"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="{Binding Changes}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Foreground="{DynamicResource Text}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource CancelDownload}" Tag="{Binding}" IsEnabled="{Binding CanCancel}" Click="CancelDownload_Click"/><Button Content="{DynamicResource RemoveQueue}" Tag="{Binding}" IsEnabled="{Binding CanRemove}" Click="RemoveDownload_Click"/></StackPanel></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>

<!-- SETTINGS -->
<Grid x:Name="SettingsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel Margin="34,24" VerticalAlignment="Center"><TextBlock Text="{DynamicResource SettingsEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11"/><TextBlock Text="{DynamicResource SettingsTitle}" Foreground="{DynamicResource Text}" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,22,34,34">
<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Language}" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{DynamicResource LanguageHelp}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" SelectionChanged="LanguageCombo_SelectionChanged"><ComboBoxItem Tag="fr" Content="{DynamicResource French}"/><ComboBoxItem Tag="en" Content="{DynamicResource English}"/></ComboBox></Grid></Border>
<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Appearance}" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{DynamicResource AppearanceHelp}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Width="250" Height="48" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="13"><Grid ClipToBounds="True"><Border x:Name="ThemeIndicator" Width="121" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentGradient}" CornerRadius="10"><Border.RenderTransform><TranslateTransform x:Name="ThemeIndicatorTransform"/></Border.RenderTransform></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource Dark}" Background="Transparent" BorderThickness="0" Click="DarkTheme_Click"/><Button Grid.Column="1" Content="{DynamicResource Light}" Background="Transparent" BorderThickness="0" Click="LightTheme_Click"/></Grid></Grid></Border></Grid></Border>
<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource UpdateSettings}" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/><CheckBox x:Name="CheckGamesStartupBox" Content="{DynamicResource CheckGamesStartup}" Foreground="{DynamicResource Text}" Margin="0,6" Checked="PreferenceCheckBox_Changed" Unchecked="PreferenceCheckBox_Changed"/><CheckBox x:Name="GameUpdatePopupBox" Content="{DynamicResource GameUpdatePopup}" Foreground="{DynamicResource Text}" Margin="0,6" Checked="PreferenceCheckBox_Changed" Unchecked="PreferenceCheckBox_Changed"/><CheckBox x:Name="RefreshModsOnOpenBox" Content="{DynamicResource RefreshModsOnOpen}" Foreground="{DynamicResource Text}" Margin="0,6" Checked="PreferenceCheckBox_Changed" Unchecked="PreferenceCheckBox_Changed"/></StackPanel></Border>
<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource DataFolder}" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="DataFolderText" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource OpenDataFolder}" Click="OpenDataFolder_Click"/><Button Content="{DynamicResource ResetSettings}" Click="ResetSettings_Click"/></StackPanel></Grid></Border>
</StackPanel></ScrollViewer></Grid>

<!-- GAME UPDATE POPUP -->
<Grid x:Name="GameUpdatePopup" Panel.ZIndex="100" Visibility="Collapsed" Background="#99000000"><Border Width="620" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="20" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="GameUpdatePopupEyebrow" Text="{DynamicResource GameUpdateAvailable}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="GameUpdatePopupTitle" Foreground="{DynamicResource Text}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock x:Name="GameUpdatePopupText" Foreground="{DynamicResource Text}" Opacity="0.82" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" MaxHeight="230"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{DynamicResource Later}" Click="UpdatePopupLater_Click"/><Button x:Name="GameUpdatePopupActionButton" Content="{DynamicResource UpdateNow}" Background="#2674D9" Click="UpdatePopupNow_Click"/></StackPanel></StackPanel></Border></Grid>
<Border x:Name="ThemeTransitionOverlay" Panel.ZIndex="150" Background="{DynamicResource Bg}" Opacity="0" IsHitTestVisible="False"/>
</Grid>
</Grid>
</Window>
