<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CubeShelf.Desktop.Controls"
        x:Class="CubeShelf.Desktop.MainWindow"
        Title="CubeShelf"
        Width="1530" Height="930" MinWidth="960" MinHeight="560"
        Background="{DynamicResource Bg}"
        Opened="OnParityWindowOpened"
        SizeChanged="OnParityWindowSizeChanged">
  <Grid ColumnDefinitions="225,*">
    <!-- SIDEBAR -->
    <Border x:Name="DesktopSidebar" Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,4,0,28" Spacing="12">
            <Border Width="46" Height="46" CornerRadius="12" Background="#101524" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="4">
              <Image Source="avares://CubeShelf/Assets/Brand/gamecube_logo.png" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="CubeShelf" Foreground="{DynamicResource Text}" FontSize="23" FontWeight="Bold" />
              <TextBlock Text="{DynamicResource BrandSubtitle}" Foreground="{DynamicResource Muted}" FontSize="10" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="NavLibraryButton" Classes="nav selected" TabIndex="1" Click="ParityShowLibrary">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▦" Width="18" /><TextBlock Text="{DynamicResource AppLibrary}" /></StackPanel>
          </Button>
          <Button x:Name="NavFavoritesButton" Classes="nav" TabIndex="2" Click="ParityShowFavorites">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="★" Width="18" /><TextBlock Text="{DynamicResource AppFavorites}" /></StackPanel>
          </Button>
          <Button x:Name="NavModsButton" Classes="nav" TabIndex="3" Click="ParityOpenMods">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◈" Width="18" /><TextBlock Text="{DynamicResource AppMods}" /></StackPanel>
          </Button>
          <Button x:Name="NavDownloadsButton" Classes="nav" TabIndex="4" Click="ParityShowDownloads">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="↓" Width="18" /><TextBlock Text="{DynamicResource AppDownloads}" /></StackPanel>
          </Button>
          <Button x:Name="NavFriendsButton" Classes="nav" TabIndex="5" Click="ParityShowFriends">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="☺" Width="18" /><TextBlock Text="{DynamicResource AppFriends}" /></StackPanel>
          </Button>
          <Button x:Name="NavOnlineButton" Classes="nav" TabIndex="6" Click="ParityShowOnline">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◉" Width="18" /><TextBlock Text="{DynamicResource AppOnline}" /><TextBlock x:Name="NavOnlineBadge" Text="●" Foreground="{DynamicResource Accent}" FontSize="10" VerticalAlignment="Center" IsVisible="False" /></StackPanel>
          </Button>
          <Button x:Name="NavSettingsButton" Classes="nav" TabIndex="6" Click="ParityShowSettings">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⚙" Width="18" /><TextBlock Text="{DynamicResource AppSettings}" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <Button x:Name="BigPictureEntryButton" Content="▣ Big Picture · F11" Click="EnterBigPicture" HorizontalAlignment="Stretch" />
          <!-- You, the way your friends see you. Clicking it opens your profile. -->
          <Button x:Name="ProfileChipButton" Classes="nav" TabIndex="7" Click="ParityShowProfile" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Panel>
                  <TextBlock Text="☺" FontSize="14" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="SidebarAvatar" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SidebarHandleText" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{DynamicResource AppProfile}" Foreground="{DynamicResource Muted}" FontSize="10" />
              </StackPanel>
            </Grid>
          </Button>
          <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Queue}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" />
              <TextBlock x:Name="QueueSidebarText" Text="{DynamicResource QueueEmpty}" Foreground="{DynamicResource Text}" FontSize="12" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="PlatformStatus" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="DataPath" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" MaxHeight="55" />
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" FontSize="10" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid x:Name="ViewHost" Grid.Column="1">
      <Grid x:Name="BigPictureHomeView" Classes="view" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource Bg}">
        <StackPanel Margin="36,24" Spacing="18">
          <TextBlock x:Name="BigPictureHomeTitle" FontSize="34" FontWeight="Bold" />
          <WrapPanel>
            <Button x:Name="BigPictureCollectionButton" Click="OpenBigPictureCollection" Margin="0,0,10,8" FontSize="18" Padding="20,12" />
            <Button x:Name="BigPictureHomeFriendsButton" Click="OpenBigPictureFriends" Margin="0,0,10,8" FontSize="18" Padding="20,12" />
            <Button x:Name="BigPictureHomeSettingsButton" Click="OpenBigPictureSettings" Margin="0,0,10,8" FontSize="18" Padding="20,12" />
            <TextBox x:Name="BigPictureHomeSearch" Width="280" TextChanged="BigPictureHomeSearchChanged" Margin="0,0,10,8" FontSize="18" />
          </WrapPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="36,0,36,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="18">
            <TextBlock x:Name="BigPictureResumeTitle" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="BigPictureResumeHint" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
            <WrapPanel x:Name="BigPictureResumeCards" />
            <TextBlock x:Name="BigPictureHomeInvitesTitle" FontSize="24" FontWeight="SemiBold" />
            <StackPanel x:Name="BigPictureHomeInvites" Spacing="12" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <ThemeVariantScope x:Name="BigPictureView" Classes="view" RequestedThemeVariant="Light" IsVisible="False">
      <Grid Background="#F5F0EE" RowDefinitions="Auto,*,Auto">
        <controls:ShelfContourBackground Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.55" />
        <Grid Margin="32,24" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="avares://CubeShelf/Assets/Brand/gamecube_logo.png" Width="32" Height="32" />
            <TextBlock Text="CubeShelf" Foreground="#302C35" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="#EFDDD8" CornerRadius="9" Padding="14,8" Margin="10,0,0,0">
              <TextBlock Text="GAMECUBE" Foreground="#80594E" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
            </Border>
          </StackPanel>
          <TextBlock x:Name="BigPictureCount" Grid.Column="1" Foreground="#706671" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BigPictureFriendsButton" Click="OpenBigPictureFriends" FontSize="14" Padding="16,10" />
            <Button x:Name="BigPictureSettingsButton" Click="OpenBigPictureSettings" FontSize="14" Padding="16,10" />
            <Button x:Name="BigPictureLayoutButton" Click="ToggleBigPictureLayout" FontSize="14" Padding="16,10" />
            <Button x:Name="BigPictureExitButton" Click="ExitBigPicture" FontSize="14" Padding="16,10" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,32,0" ColumnDefinitions="7*,3*" ColumnSpacing="12">
          <controls:GameShelfControl x:Name="BigPictureShelf" />
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" MaxHeight="620">
            <StackPanel Spacing="14" Margin="0,20,0,20">
              <TextBlock x:Name="BigPictureCollectionLabel" Foreground="#9B7066" FontSize="10" LetterSpacing="2" FontWeight="Bold" />
              <Border Background="#EEDCD6" CornerRadius="16" Padding="24">
                <StackPanel Spacing="14">
                  <controls:GameTitleControl x:Name="BigPictureTitle" Foreground="#302C35" FontSize="30" />
                  <TextBlock x:Name="BigPictureMetadata" Foreground="#80594E" FontSize="14" TextWrapping="Wrap" />
                  <TextBlock x:Name="BigPictureDescription" Foreground="#6E6166" FontSize="14" TextWrapping="Wrap" MaxHeight="102" />
                </StackPanel>
              </Border>
              <Button x:Name="BigPicturePlayButton" Classes="primary" Click="PlayBigPicture" FontSize="20" Padding="24,16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="BigPictureOnlineButton" Click="OpenBigPictureOnline" FontSize="18" Padding="20,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="BigPictureModsButton" Click="OpenBigPictureMods" FontSize="17" Padding="18,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock x:Name="BigPictureStatus" Foreground="#706671" FontSize="14" TextWrapping="Wrap" />
              <Button x:Name="BigPictureFlipButton" Click="FlipBigPictureCase" FontSize="14" Padding="16,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="BigPictureCancelButton" Click="CancelBigPictureLaunch" IsVisible="False" FontSize="16" Padding="18,12" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Margin="32,16,32,24" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
          <Button x:Name="BigPicturePreviousButton" Content="❮" Click="PreviousBigPictureGame" Padding="16,8" />
          <Border Grid.Column="1" CornerRadius="8" Background="#EFDDD8" Padding="16,10">
            <TextBlock x:Name="BigPicturePosition" Foreground="#80594E" FontSize="13" VerticalAlignment="Center" />
          </Border>
          <Button x:Name="BigPictureNextButton" Grid.Column="2" Content="❯" Click="NextBigPictureGame" Padding="16,8" />
          <TextBlock x:Name="BigPictureHelp" Grid.Column="3" Foreground="#706671" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Grid>
      </ThemeVariantScope>
      <Grid x:Name="BigPictureModsView" Classes="view" IsVisible="False" RowDefinitions="Auto,*,Auto" Background="{DynamicResource Bg}">
        <StackPanel Margin="40,28" Spacing="10">
          <TextBlock x:Name="BigPictureModsTitle" FontSize="30" FontWeight="Bold" />
          <TextBlock x:Name="BigPictureModsSummary" FontSize="17" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
          <WrapPanel>
            <ComboBox x:Name="BigPictureProfilePicker" Width="250" Margin="0,4,8,4" />
            <Button x:Name="BigPictureApplyProfileButton" Click="ApplyBigPictureProfile" Margin="0,4,8,4" />
            <TextBox x:Name="BigPictureProfileNameBox" Width="220" MaxLength="80" Margin="0,4,8,4" />
            <Button x:Name="BigPictureSaveProfileButton" Click="SaveBigPictureProfile" Margin="0,4,8,4" />
            <Button x:Name="BigPictureDeleteProfileButton" Click="DeleteBigPictureProfile" Margin="0,4,8,4" />
          </WrapPanel>
          <TextBlock x:Name="BigPictureProfileStatus" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="40,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="BigPictureModChoices" Spacing="12" />
        </ScrollViewer>
        <Button Grid.Row="2" x:Name="BigPictureBrowseModsButton" Click="BrowseBigPictureMods" FontSize="19" Padding="24,16" Margin="40,24" HorizontalAlignment="Left" />
      </Grid>
      <!-- LIBRARY -->
      <Grid x:Name="LibraryView" Classes="view" RowDefinitions="155,*">
        <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <Grid Margin="34,24" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="5">
              <TextBlock Text="{DynamicResource LibraryEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" />
              <TextBlock x:Name="LibrarySectionTitle" Text="{DynamicResource LibraryTitle}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="34" />
              <TextBlock Text="{DynamicResource LibrarySubtitle}" Foreground="{DynamicResource Muted}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
              <TextBox x:Name="LibrarySearchBox" Width="210" TabIndex="10" Watermark="{DynamicResource SearchGame}" TextChanged="LibrarySearchChanged" />
              <ComboBox x:Name="LibrarySortCombo" Width="170" TabIndex="11" SelectionChanged="LibrarySortChanged">
                <ComboBoxItem Content="{DynamicResource SortName}" />
                <ComboBoxItem Content="{DynamicResource SortRecent}" />
                <ComboBoxItem Content="{DynamicResource SortPlaytime}" />
              </ComboBox>
              <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14,8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{DynamicResource LibraryCountLabel}" Foreground="{DynamicResource Muted}" FontSize="9" />
                  <TextBlock x:Name="LibraryUpdatesText" Text="—" Foreground="{DynamicResource Text}" FontWeight="Bold" />
                </StackPanel>
              </Border>
              <Button Content="{DynamicResource AddGame}" Click="AddCustomGamePhase6" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="26,22,26,30">
            <ItemsControl x:Name="LibraryCards">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="10">
                    <Border Width="260" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="13">
                      <StackPanel>
                        <Button Classes="game-card" Tag="{Binding}" Click="SelectLibraryGame" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch">
                        <Grid>
                          <Border Height="330" Background="#090C13" CornerRadius="11" ClipToBounds="True">
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                          </Border>
                          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC101524" CornerRadius="9" Padding="8,5" Margin="8">
                            <TextBlock Text="{Binding Favorite}" Foreground="#FFD86B" FontSize="14" FontWeight="Bold" />
                          </Border>
                        </Grid>
                        </Button>
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="18" Margin="3,13,3,0" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="3,4,3,0" />
                        <TextBlock Text="{Binding PlayHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" MinHeight="36" Margin="3,10,3,4" />
                        <TextBlock Text="{Binding Stats}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="3,6,3,1" />
                        <TextBlock Text="{Binding Update}" Foreground="{DynamicResource Accent2}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,4,3,1" />
                        <Button Classes="primary" Tag="{Binding}" Click="QuickPlayLibraryGame" IsEnabled="{Binding CanQuickPlay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,5" AutomationProperties.Name="{Binding PlayLabel}">
                          <TextBlock Text="{Binding PlayLabel}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                        <WrapPanel>
                          <Button Content="{DynamicResource GameDetails}" Tag="{Binding}" Click="SelectLibraryGame" Padding="10,5" Margin="0,0,5,0" />
                          <Button Content="{DynamicResource CancelGameLaunch}" Tag="{Binding}" Click="CancelQuickPlay" IsVisible="{Binding IsPreparing}" Padding="10,5" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyLibraryText" Text="{DynamicResource NoLibraryMatch}" Foreground="{DynamicResource Muted}" FontSize="18" HorizontalAlignment="Center" Margin="0,80" IsVisible="False" />
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- GAME -->
      <Grid x:Name="GameView" Classes="view" IsVisible="False" RowDefinitions="74,*">
        <Grid Margin="28,13,28,7" ColumnDefinitions="Auto,*,Auto">
          <Button Content="{DynamicResource BackLibrary}" Click="ParityShowLibrary" />
          <TextBlock x:Name="GameTitle" Grid.Column="1" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0" FontSize="13" />
          <Button Grid.Column="2" Content="{DynamicResource FlipCase}" Click="FlipGameCase" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,8,34,35" Spacing="18">
            <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="20" Padding="30">
              <Grid ColumnDefinitions="1.08*,0.92*">
                <StackPanel VerticalAlignment="Center" Margin="5,0,36,0" Spacing="10">
                  <TextBlock Text="{DynamicResource SelectedGame}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" />
                  <TextBlock x:Name="SelectedTitleText" Text="Mario Party 4" Foreground="{DynamicResource Text}" FontSize="52" FontWeight="ExtraBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="SelectedMetaText" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock x:Name="SelectedDescriptionText" Foreground="{DynamicResource Text}" Opacity="0.82" FontSize="15" LineHeight="23" TextWrapping="Wrap" />
                  <TextBlock x:Name="GameStatsText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock x:Name="SetupProgressText" Foreground="{DynamicResource Accent2}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />

                  <WrapPanel>
                    <Button x:Name="PlayButton" Classes="primary" Content="{DynamicResource Play}" IsEnabled="False" Click="PlayGame" Margin="0,0,8,6" />
                    <Button x:Name="CancelPlayLaunchButton" Content="{DynamicResource CancelGameLaunch}" IsVisible="False" Click="CancelQuickPlay" Margin="0,0,8,6" />
                    <Button x:Name="FavoriteButton" Content="{DynamicResource FavoriteAdd}" Click="ToggleFavoriteParity" Margin="0,0,8,6" />
                    <Button Content="{DynamicResource Mods}" Click="ParityOpenMods" Margin="0,0,8,6" />
                  </WrapPanel>
                </StackPanel>
                <controls:GameCaseControl x:Name="GameCase" Grid.Column="1" Width="430" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Expander x:Name="GameAdvancedOptions" Header="{DynamicResource AdvancedGameOptions}" IsExpanded="True" HorizontalAlignment="Stretch" Foreground="{DynamicResource Text}">
              <StackPanel Spacing="18" Margin="0,12,0,0">
                  <WrapPanel>
                    <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="0,0,6,6"><TextBlock x:Name="OriginalGameStateText" FontSize="11" /></Border>
                    <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="0,0,6,6"><TextBlock x:Name="RuntimeStateText" FontSize="11" /></Border>
                    <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="0,0,6,6"><TextBlock x:Name="DataStateText" FontSize="11" /></Border>
                    <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="0,0,6,6"><TextBlock x:Name="GameUpdateStateText" Text="{DynamicResource GameUpdateUnknown}" FontSize="11" /></Border>
                  </WrapPanel>
            <Grid ColumnDefinitions="*,18,*">
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="9">
                  <TextBlock Text="{DynamicResource GameDiscLabel}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="DiscPathText" Text="{DynamicResource NoDisc}" Foreground="{DynamicResource Text}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="DiscCompatibilityText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{DynamicResource ChooseDisc}" Click="ChooseDisc" />
                    <Button Content="{DynamicResource Clear}" Click="ClearDisc" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="9">
                  <TextBlock x:Name="RuntimeSectionLabel" Text="{DynamicResource PartyBoardLabel}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="ExecutablePathText" Text="{DynamicResource NoRuntime}" Foreground="{DynamicResource Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button x:Name="InstallButton" Classes="primary" Content="{DynamicResource InstallPartyBoard}" Click="InstallPartyBoard" />
                    <Button x:Name="RepairButton" Content="{DynamicResource Repair}" IsVisible="False" Click="RepairPartyBoard" />
                    <Button x:Name="UninstallButton" Content="{DynamicResource Uninstall}" IsVisible="False" Click="UninstallGamePhase6" />
                    <Button x:Name="PrepareDataButton" Content="{DynamicResource PrepareGameData}" Click="PrepareGameDataPhase4" />
                    <Button Content="{DynamicResource ManualExecutable}" Click="ChooseExecutable" />
                    <Button x:Name="CancelInstallButton" Classes="danger" Content="{DynamicResource CancelDownload}" IsVisible="False" Click="CancelInstall" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource InstalledMods}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{DynamicResource ManageMods}" Click="ParityOpenMods" />
                </Grid>
                <TextBlock x:Name="GameModsEmpty" Text="{DynamicResource NoModsInstalled}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                <ItemsControl x:Name="GameModsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Content="{Binding Action}" Tag="{Binding Id}" Click="ToggleModFromGamePage" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="GameModsWarning" Foreground="{DynamicResource Warning}" FontSize="11" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="{DynamicResource GameUpdates}" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="GitHubUpdateStatusText" Text="{DynamicResource GameUpdateUnknown}" Foreground="{DynamicResource Text}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="GitHubCommitText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock x:Name="GitHubChangesText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="125" />
                  <TextBlock x:Name="SourceSafetyText" Foreground="{DynamicResource Accent2}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="8" Margin="16,0,0,0">
                  <Button x:Name="CheckGameUpdateButton" Content="{DynamicResource Check}" Click="CheckGameUpdatePhase3" />
                  <Button x:Name="DownloadSourceButton" Content="{DynamicResource DownloadSource}" Click="DownloadGameSourcePhase3" />
                  <Button x:Name="DeleteSourceButton" Content="{DynamicResource DeleteSource}" IsVisible="False" Click="DeleteGameSourcePhase3" />
                </StackPanel>
              </Grid>
            </Border>
              </StackPanel>
            </Expander>
            <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" IsVisible="False" Height="9" />
            <TextBlock x:Name="ActionStatus" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- MODS -->
      <Grid x:Name="ModsView" Classes="view" IsVisible="False" RowDefinitions="Auto,*,Auto">
        <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <StackPanel Margin="34,18" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ModsGameHeading" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ModsBackButton" Content="{DynamicResource BackGame}" Click="BackFromMods" />
                <Button x:Name="RefreshModsButton" Content="{DynamicResource RefreshGameBanana}" Click="RefreshMods" />
              </StackPanel>
            </Grid>
            <TabControl x:Name="ModsTabs" SelectedIndex="0" SelectionChanged="ModsTabChanged" Height="54">
              <TabItem x:Name="InstalledModsTab" Header="Mes mods" FontSize="19" Focusable="True" />
              <TabItem x:Name="GameBananaModsTab" Header="GameBanana" FontSize="19" Focusable="True" />
            </TabControl>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24,18,24,24" ColumnDefinitions="*,18,440">
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="ModSearchBox" Watermark="Rechercher un mod…" KeyUp="ModSearchKeyUp" MinHeight="44" />
                  <Button x:Name="SearchModsButton" Grid.Column="1" Content="Rechercher" Click="SearchModsTab" Margin="8,0,0,0" MinHeight="44" />
                </Grid>
                <WrapPanel>
                  <ComboBox x:Name="ModCategoryFilter" MinWidth="150" Margin="0,0,8,6" SelectionChanged="ModFiltersChanged" />
                  <ComboBox x:Name="ModStateFilter" MinWidth="140" Margin="0,0,8,6" SelectionChanged="ModFiltersChanged" />
                  <ComboBox x:Name="ModSortFilter" MinWidth="130" Margin="0,0,8,6" SelectionChanged="ModFiltersChanged" />
                </WrapPanel>
              </StackPanel>
              <TextBlock x:Name="ModResultCount" Grid.Row="1" Margin="4,8,0,4" FontSize="11" Foreground="{DynamicResource Muted}" />
              <ListBox x:Name="ModsList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="SelectMod"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Width="232" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                      <StackPanel>
                        <Border Height="130" Background="#090C13">
                          <Grid>
                            <TextBlock Text="{Binding Category}" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            <Border IsVisible="{Binding Installed}" Background="{DynamicResource Accent}" CornerRadius="8" Padding="7,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                            </Border>
                          </Grid>
                        </Border>
                        <StackPanel Margin="10,8,10,10" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Byline}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Accent2}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="ModsEmptyState" Grid.Row="2" IsVisible="False" FontSize="19" Margin="24"
                         TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
            <ScrollViewer><StackPanel x:Name="ModDetailsPanel" Spacing="12" Focusable="True">
              <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock x:Name="ModTitle" Text="{DynamicResource SelectMod}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock x:Name="ModVersion" Foreground="{DynamicResource Muted}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenModImageButton" Content="{DynamicResource ViewImage}" IsEnabled="False" Click="OpenCurrentModImagePhase6" /><Button x:Name="OpenModPageButton" Content="{DynamicResource GameBanana}" IsEnabled="False" Click="OpenModPage" /></StackPanel></Grid>
              <Border Height="240" Background="#090C13" CornerRadius="14" ClipToBounds="True">
                <Grid>
                  <Image x:Name="ModPreview" Stretch="Uniform" />
                  <Button x:Name="PreviousModImageButton" Content="‹" Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsEnabled="False" Click="PreviousModImagePhase6" />
                  <Button x:Name="NextModImageButton" Content="›" Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="False" Click="NextModImagePhase6" />
                  <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#BB090C13" CornerRadius="9" Padding="10,5" Margin="0,0,0,10"><TextBlock x:Name="ModGalleryCounter" Text="0 / 0" Foreground="White" FontSize="11" /></Border>
                </Grid>
              </Border>
              <TextBlock x:Name="ModDescription" TextWrapping="Wrap" Foreground="{DynamicResource Text}" Opacity="0.84" />
              <TextBlock x:Name="ModInstructions" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
              <TextBlock x:Name="ModDetailStatus" TextWrapping="Wrap" Foreground="{DynamicResource Accent2}" />
              <StackPanel Orientation="Horizontal"><Button x:Name="InstallModButton" Classes="primary" Content="{DynamicResource Install}" IsEnabled="False" Click="InstallMod" /><Button x:Name="ToggleModButton" Content="{DynamicResource Enable}" IsEnabled="False" Click="ToggleMod" /><Button x:Name="DeleteModButton" Content="{DynamicResource Delete}" IsEnabled="False" Click="DeleteMod" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{DynamicResource Priority}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" /><TextBox x:Name="ModPriority" Width="90" Text="100" /><Button Content="{DynamicResource Apply}" Click="ApplyModPriority" /></StackPanel>
              <ProgressBar x:Name="ModProgress" Minimum="0" Maximum="100" IsVisible="False" />
              <TextBlock x:Name="ModsStatus" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
              <TextBlock x:Name="ConflictsStatus" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <Border x:Name="ModsControllerHint" Grid.Row="2" IsVisible="False" Background="{DynamicResource Panel2}" Padding="24,14">
          <TextBlock x:Name="ModsControllerHelp" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
        </Border>
      </Grid>

      <!-- DOWNLOADS -->
      <Grid x:Name="DownloadsView" Classes="view" IsVisible="False">
        <controls:DownloadsManager x:Name="DownloadManager" />
      </Grid>

      <!-- SETTINGS -->
      <ScrollViewer x:Name="SettingsView" Classes="view" IsVisible="False">
        <StackPanel Margin="34,26,34,34" Spacing="14">
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource StartupModeTitle}" FontSize="18" FontWeight="Bold" />
              <CheckBox x:Name="StartInBigPictureBox" Content="{DynamicResource StartInBigPicture}" Checked="SaveSettings" Unchecked="SaveSettings" />
              <TextBlock Text="{DynamicResource StartupModeHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,4">
            <StackPanel Spacing="5"><TextBlock Text="{DynamicResource SettingsEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" /><TextBlock Text="{DynamicResource SettingsTitle}" FontSize="32" FontWeight="Bold" /><TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="{DynamicResource Muted}" /></StackPanel>
          </Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,240"><StackPanel><TextBlock Text="{DynamicResource Language}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource LanguageHelp}" Foreground="{DynamicResource Muted}" /></StackPanel><ComboBox x:Name="LanguagePicker" Grid.Column="1" SelectionChanged="SaveSettings"><ComboBoxItem Content="{DynamicResource LanguageAuto}" Tag="auto" /><ComboBoxItem Content="Français" Tag="fr" /><ComboBoxItem Content="English" Tag="en" /></ComboBox></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,240"><StackPanel><TextBlock Text="{DynamicResource Appearance}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource AppearanceHelp}" Foreground="{DynamicResource Muted}" /></StackPanel><ComboBox x:Name="ThemePicker" Grid.Column="1" SelectionChanged="SaveSettings"><ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="dark" /><ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="light" /></ComboBox></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{DynamicResource WindowLayout}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource WindowLayoutHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="AutoFitWindowBox" Content="{DynamicResource AutoFitWindow}" Checked="SaveAutoFitPhase5" Unchecked="SaveAutoFitPhase5" /><Button Content="{DynamicResource FitWindowNow}" Click="FitWindowNowPhase5" /></StackPanel></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="7"><TextBlock Text="{DynamicResource UpdateSettings}" FontSize="18" FontWeight="Bold" /><CheckBox x:Name="CheckUpdatesBox" Content="{DynamicResource UpdateAtStartup}" Checked="SaveSettings" Unchecked="SaveSettings" /><CheckBox x:Name="UpdatePopupBox" Content="{DynamicResource UpdatePopup}" Checked="SaveSettings" Unchecked="SaveSettings" /><CheckBox x:Name="RefreshModsBox" Content="{DynamicResource RefreshModsOnOpen}" Checked="SaveSettings" Unchecked="SaveSettings" /><Button x:Name="CheckLauncherUpdateButton" Content="{DynamicResource CheckLauncherUpdate}" HorizontalAlignment="Left" Click="CheckLauncherUpdatePhase4" /><TextBlock x:Name="LauncherUpdateStatusText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /></StackPanel></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource DolphinToolTitle}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource DolphinHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /><TextBlock x:Name="DolphinToolStatusText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource DolphinDetect}" Click="RefreshDolphinStatusPhase4" /><Button x:Name="InstallDolphinToolButton" Content="{DynamicResource DolphinInstall}" Click="InstallDolphinToolPhase4" /><Button Content="{DynamicResource OpenTools}" Click="OpenToolsFolderPhase4" /></StackPanel></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{DynamicResource Storage}" FontSize="18" FontWeight="Bold" /><TextBlock x:Name="SettingsDataPath" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /><TextBlock x:Name="StorageSummaryText" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource OpenDataFolder}" Click="OpenDataDirectory" /><Button Content="{DynamicResource Refresh}" Click="RefreshStoragePhase6Click" /><Button Content="{DynamicResource CleanCache}" Click="CleanCachePhase6" /></StackPanel></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource Shortcuts}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource ShortcutsHelp}" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="ShortcutSummaryText" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{DynamicResource FirstRunAssistant}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource StartupAssistantHelp}" Foreground="{DynamicResource Muted}" /></StackPanel><Button Grid.Column="1" Content="{DynamicResource RunAssistant}" Click="RunFirstStartWizard" /></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{DynamicResource Diagnostics}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource DiagnosticsHelp}" Foreground="{DynamicResource Muted}" /></StackPanel><Button Grid.Column="1" Content="{DynamicResource OpenDiagnostics}" Click="OpenDiagnosticsPhase6" /></Grid></Border>
          <!-- The network: how friends see each other from anywhere, with no server and no cloud. -->
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel Spacing="9">
              <TextBlock Text="{DynamicResource MeshTitle}" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="{DynamicResource MeshHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              <TextBlock x:Name="MeshStatusText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
              <CheckBox x:Name="MeshEnabledBox" Content="{DynamicResource MeshEnabled}" Checked="SaveSettings" Unchecked="SaveSettings" />
              <CheckBox x:Name="MeshMapPortBox" Content="{DynamicResource MeshMapPort}" Checked="SaveSettings" Unchecked="SaveSettings" />
              <CheckBox x:Name="MeshPublicDiscoveryBox" Content="{DynamicResource MeshPublicDiscovery}" Checked="SaveSettings" Unchecked="SaveSettings" />
              <TextBlock Text="{DynamicResource MeshPublicDiscoveryHelp}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource MeshPrivacy}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <!-- One RetroAchievements login for every game that can take it. -->
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel Spacing="9">
              <TextBlock Text="{DynamicResource RaTitle}" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="{DynamicResource RaHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              <TextBlock x:Name="RaStatusText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
              <StackPanel x:Name="RaLoginPanel" Spacing="8">
                <TextBox x:Name="RaUserBox" MaxLength="64" Watermark="{DynamicResource RaUser}" />
                <TextBox x:Name="RaPasswordBox" PasswordChar="•" Watermark="{DynamicResource RaPassword}" />
                <StackPanel Orientation="Horizontal"><Button x:Name="RaLoginButton" Classes="primary" Content="{DynamicResource RaLogin}" Click="LoginRetroAchievements" /></StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal"><Button x:Name="RaLogoutButton" Content="{DynamicResource RaLogout}" Click="LogoutRetroAchievements" IsVisible="False" /></StackPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource Presence}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{DynamicResource PresenceMovedHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="{DynamicResource OpenProfile}" Click="ParityShowProfile" VerticalAlignment="Center" /></Grid></Border>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock x:Name="MaintenanceTitle" FontSize="18" FontWeight="Bold" />
              <TextBlock x:Name="MaintenanceHelp" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              <WrapPanel>
                <Button x:Name="BackupProfileButton" Click="BackupLauncherProfile" Margin="0,0,8,8" />
                <Button x:Name="RestoreProfileButton" Click="RestoreLauncherProfile" Margin="0,0,8,8" />
                <Button x:Name="RestoreCardsButton" Click="RestoreMemoryCards" Margin="0,0,8,8" />
                <Button x:Name="PreviousLauncherButton" Click="RestorePreviousLauncher" Margin="0,0,8,8" />
                <Button x:Name="MeasureLauncherButton" Click="MeasureLauncherPerformance" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock x:Name="MaintenanceStatus" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource ResetSettings}" Click="ResetSettings" /></StackPanel>
          <TextBlock x:Name="SettingsStatus" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <!-- FRIENDS -->
      <Grid x:Name="FriendsView" Classes="view" IsVisible="False" RowDefinitions="132,*">
        <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <Grid Margin="34,24" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource FriendsEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" />
              <TextBlock Text="{DynamicResource FriendsTitle}" Foreground="{DynamicResource Text}" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" />
              <TextBlock x:Name="FriendsSubtitleText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox x:Name="AvailabilityPicker" MinWidth="170" VerticalAlignment="Center" Margin="0,0,8,0" SelectionChanged="AvailabilityChanged" />
              <Button Content="{DynamicResource AddFriend}" Classes="primary" Click="AddFriend" />
              <Button Content="{DynamicResource LanAdd}" Click="OpenLanDialog" />
              <Button Content="{DynamicResource FriendsRefresh}" Click="RefreshFriendsNow" />
              <Button Content="{DynamicResource AppProfile}" Click="ParityShowProfile" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Margin="28,20,28,28" Background="{DynamicResource Panel}" CornerRadius="14" Padding="14">
          <Grid RowDefinitions="Auto,*">
            <StackPanel>
            <!-- Requests that came through the network: someone added us and asks to be added back. -->
            <Border x:Name="MeshRequestsPanel" IsVisible="False" Margin="0,0,0,12" Padding="14" CornerRadius="12" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Accent2}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource MeshRequestsTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                <ItemsControl x:Name="MeshRequestsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="primary" Content="{DynamicResource MeshRequestAccept}" Tag="{Binding}" Click="AcceptMeshRequest" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{DynamicResource MeshRequestDecline}" Tag="{Binding}" Click="DeclineMeshRequest" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- A friend code found in the clipboard: copy the message in any chat app, come back, one click. -->
            <Border x:Name="ClipboardInviteBanner" IsVisible="False" Margin="0,0,0,12" Padding="14" CornerRadius="12" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="ClipboardInviteText" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ClipboardAddButton" Classes="primary" Content="{DynamicResource ClipboardAdd}" Click="AddFriendFromClipboard" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="{DynamicResource ClipboardIgnore}" Click="IgnoreClipboardCode" VerticalAlignment="Center" />
              </Grid>
            </Border>
            </StackPanel>
            <Grid Grid.Row="1">
            <ListBox x:Name="FriendsList" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                    <Grid ColumnDefinitions="1.4*,2*,Auto">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" VerticalAlignment="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                          <Panel>
                            <TextBlock Text="☺" FontSize="18" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent2}" FontSize="12" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="18,0">
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource Text}" Opacity="0.8" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding HasStatusLine}" />
                        <TextBlock Text="{Binding Extra}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="primary" Content="{DynamicResource FriendJoin}" Tag="{Binding}" IsVisible="{Binding CanJoin}" Click="JoinFriendInvite" />
                        <Button Content="{DynamicResource FriendDecline}" Tag="{Binding}" IsVisible="{Binding CanJoin}" Click="DeclineFriendInvite" />
                        <Button Content="{DynamicResource FriendMessage}" Tag="{Binding}" IsVisible="{Binding CanMessage}" Click="OpenChat" />
                        <Button Classes="primary" Content="{DynamicResource FriendInvite}" Tag="{Binding}" IsVisible="{Binding CanInvite}" Click="InviteFriend" />
                        <Button Classes="primary" Content="{DynamicResource FriendSendMyCode}" Tag="{Binding}" IsVisible="{Binding CanSendOwnCode}" Click="SendOwnCodeToFriend" />
                        <Button Content="{Binding PauseAction}" Tag="{Binding}" IsVisible="{Binding CanBlock}" Click="ToggleFriendPause" />
                        <Button Content="{DynamicResource FriendCopyCode}" Tag="{Binding}" IsVisible="{Binding CanBlock}" IsEnabled="{Binding CanCopyCode}" Click="CopyFriendCode" />
                        <Button Content="{DynamicResource FriendUnblock}" Tag="{Binding}" IsVisible="{Binding IsBlocked}" Click="UnblockFriend" />
                        <Button Classes="danger" Content="{DynamicResource FriendBlock}" Tag="{Binding}" IsVisible="{Binding CanBlock}" Click="BlockFriend" />
                        <Button Classes="danger" Content="{DynamicResource FriendRemove}" Tag="{Binding}" IsVisible="{Binding CanBlock}" Click="RemoveFriend" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="FriendsEmptyText" Text="{DynamicResource FriendsEmpty}" Foreground="{DynamicResource Muted}" FontSize="16" HorizontalAlignment="Center" Margin="0,60" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" IsVisible="False" />
            <StackPanel x:Name="FriendsIdentityGate" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560" Margin="0,40">
              <TextBlock Text="{DynamicResource FriendsNeedIdentity}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="primary" HorizontalAlignment="Center" Content="{DynamicResource IdentityCreate}" Click="ParityShowProfile" />
            </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- ONLINE: rooms to join now, games under way, and the player's own room, kept in step
           with the companion that hosts it (room.json). -->
      <Grid x:Name="OnlineView" Classes="view" IsVisible="False" RowDefinitions="132,*">
        <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <Grid Margin="34,24" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource OnlineEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" />
              <TextBlock Text="{DynamicResource OnlineTitle}" Foreground="{DynamicResource Text}" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" />
              <TextBlock x:Name="OnlineSubtitleText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox x:Name="OnlineGamePicker" MinWidth="190" VerticalAlignment="Center" Margin="0,0,8,0" SelectionChanged="OnlineGameChanged" />
              <ComboBox x:Name="RoomLanguageFilter" MinWidth="170" VerticalAlignment="Center" Margin="0,0,8,0" SelectionChanged="RoomLanguageFilterChanged" />
              <Button x:Name="OnlineRefreshButton" Content="{DynamicResource OnlineRefresh}" Click="RefreshOnlineNow" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="28,20,28,28" Spacing="14">
            <Border x:Name="OnlineGate" IsVisible="False" Padding="16" CornerRadius="12" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Warning}" BorderThickness="1">
              <TextBlock x:Name="OnlineGateText" TextWrapping="Wrap" />
            </Border>
            <Border Padding="16" CornerRadius="14" Background="{DynamicResource Panel}">
              <StackPanel Spacing="10">
                <TextBlock x:Name="RoomCodeHeading" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="RoomCodeHelp" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                <WrapPanel>
                  <TextBox x:Name="RoomCodeBox" Width="280" MaxLength="80" Margin="0,0,10,8" />
                  <Button x:Name="JoinRoomCodeButton" Click="JoinRoomByCode" Margin="0,0,10,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <!-- The room itself, shown here rather than in a window of its own: the companion runs
                 headless and room.json says what its window would have shown. -->
            <Border x:Name="MyRoomPanel" IsVisible="False" Padding="16" CornerRadius="14" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="66" Height="92" CornerRadius="6" ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Top" Background="{DynamicResource Panel2}">
                    <Image x:Name="MyRoomCover" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{DynamicResource OnlineMyRoom}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="MyRoomTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MyRoomActivity" Foreground="{DynamicResource Accent2}" FontStyle="Italic" TextWrapping="Wrap" IsVisible="False" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MyRoomVisibilityButton" Click="ToggleMyRoomVisibility" />
                    <Button x:Name="MyRoomInviteButton" Content="{DynamicResource OnlineInviteFriends}" Click="InviteFriendsToMyRoom" />
                    <Button x:Name="MyRoomCloseButton" Classes="danger" Content="{DynamicResource OnlineCloseRoom}" Click="CloseMyRoom" />
                  </StackPanel>
                </Grid>
                <ItemsControl x:Name="MyRoomSeats">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="1.2*,1.4*,Auto,Auto">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource Accent2}" FontSize="12" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="{Binding Disc}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Mods}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Ping}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                          <Button Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Content="{DynamicResource OnlineKick}" Tag="{Binding Seat}" IsVisible="{Binding CanKick}" Click="KickFromMyRoom" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="MyRoomMods" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel x:Name="MyRoomRenamePanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
                  <TextBox x:Name="MyRoomNameBox" MaxLength="32" MinWidth="280" Watermark="{DynamicResource OnlineRenameHint}" />
                  <Button x:Name="MyRoomRenameButton" Content="{DynamicResource OnlineRename}" Click="RenameMyRoom" />
                </StackPanel>
                <TextBlock x:Name="MyRoomMessage" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                <TextBlock x:Name="MyRoomReadySummary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <WrapPanel>
                  <TextBlock x:Name="MyRoomJoinCode" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,8" />
                  <Button x:Name="CopyMyRoomCodeButton" Click="CopyMyRoomJoinCode" Margin="0,0,0,8" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="MyRoomStartButton" Classes="primary" Content="{DynamicResource OnlineStart}" Click="StartMyRoom" />
                  <Button x:Name="MyRoomModsButton" Content="{DynamicResource OnlineRoomMods}" Click="ChooseMyRoomMods" />
                  <Button x:Name="MyRoomAlignButton" Content="{DynamicResource OnlineAlignHost}" Click="AlignMyRoomOnHost" />
                  <Button x:Name="MyRoomInstallButton" Classes="primary" Content="{DynamicResource OnlineInstallMissing}" Click="InstallMyRoomMissing" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="CreateRoomPanel" Padding="16" CornerRadius="14" Background="{DynamicResource Panel}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource OnlineCreateTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                  <TextBlock Text="{DynamicResource OnlineCreateHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CreateRoomButton" Classes="primary" VerticalAlignment="Center" Content="{DynamicResource OnlineCreateOpen}" Click="OpenRoomSetup" />
              </Grid>
            </Border>
            <TextBlock Text="{DynamicResource OnlineAvailable}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="2,6,0,0" />
            <ItemsControl x:Name="AvailableRoomsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="66" Height="92" CornerRadius="6" ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Top" Background="{DynamicResource Panel}">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GameLine}" Foreground="{DynamicResource Accent2}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ActivityLine}" Foreground="{DynamicResource Text}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding HasActivity}" />
                        <TextBlock Text="{Binding PlayersLine}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ModItems}" Margin="0,2,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{Binding Action}" Tag="{Binding}" IsVisible="{Binding CanDownload}" Padding="10,2" FontSize="12" Click="DownloadRoomMod" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding NoModsLine}" Foreground="{DynamicResource Muted}" FontSize="12" IsVisible="{Binding HasNoMods}" />
                        <TextBlock Text="{Binding CompatText}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding CompatOk}" />
                        <TextBlock Text="{Binding CompatText}" Foreground="{DynamicResource Warning}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding CompatWarn}" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Content="{Binding JoinLabel}" Tag="{Binding}" IsVisible="{Binding CanJoin}" IsEnabled="{Binding JoinEnabled}" Click="JoinPublicRoom" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="AvailableRoomsEmpty" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" IsVisible="False" />
            <TextBlock Text="{DynamicResource OnlinePlaying}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="2,6,0,0" />
            <ItemsControl x:Name="PlayingRoomsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="66" Height="92" CornerRadius="6" ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Top" Background="{DynamicResource Panel}">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GameLine}" Foreground="{DynamicResource Accent2}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ActivityLine}" Foreground="{DynamicResource Text}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding HasActivity}" />
                        <TextBlock Text="{Binding PlayersLine}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ModItems}" Margin="0,2,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{Binding Action}" Tag="{Binding}" IsVisible="{Binding CanDownload}" Padding="10,2" FontSize="12" Click="DownloadRoomMod" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding NoModsLine}" Foreground="{DynamicResource Muted}" FontSize="12" IsVisible="{Binding HasNoMods}" />
                        <TextBlock Text="{Binding CompatText}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding CompatOk}" />
                        <TextBlock Text="{Binding CompatText}" Foreground="{DynamicResource Warning}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding CompatWarn}" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Content="{Binding JoinLabel}" Tag="{Binding}" IsVisible="{Binding CanJoin}" IsEnabled="{Binding JoinEnabled}" Click="JoinPublicRoom" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="PlayingRoomsEmpty" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" IsVisible="False" />
            <TextBlock x:Name="OnlineStatusText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ROOM SETUP: the page a room is configured on before it opens. -->
      <Grid x:Name="RoomSetupView" Classes="view" IsVisible="False" RowDefinitions="132,*">
        <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <Grid Margin="34,24" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource OnlineEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" />
              <TextBlock Text="{DynamicResource OnlineSetupTitle}" Foreground="{DynamicResource Text}" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" />
              <TextBlock x:Name="RoomSetupSubtitle" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Content="{DynamicResource OnlineSetupBack}" Click="CloseRoomSetup" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="28,20,28,28" Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
            <Border Padding="18" CornerRadius="14" Background="{DynamicResource Panel}">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource OnlineSetupVisibility}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                <RadioButton x:Name="RoomPublicRadio" GroupName="RoomVisibility" IsChecked="True" Content="{DynamicResource OnlineSetupPublic}" />
                <RadioButton x:Name="RoomPrivateRadio" GroupName="RoomVisibility" Content="{DynamicResource OnlineSetupPrivate}" />
                <TextBlock Text="{DynamicResource OnlineSetupVisibilityHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="14" Background="{DynamicResource Panel}">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource OnlineSetupPlayers}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton x:Name="RoomPlayers2Radio" GroupName="RoomPlayers" IsChecked="True" Content="2" />
                  <RadioButton x:Name="RoomPlayers3Radio" GroupName="RoomPlayers" Content="3" />
                  <RadioButton x:Name="RoomPlayers4Radio" GroupName="RoomPlayers" Content="4" />
                </StackPanel>
                <TextBlock Text="{DynamicResource OnlineSetupPlayersHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="14" Background="{DynamicResource Panel}">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource OnlineSetupName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                <TextBox x:Name="RoomNameBox" MaxLength="32" MinWidth="420" HorizontalAlignment="Left" />
                <TextBlock Text="{DynamicResource OnlineSetupNameHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="14" Background="{DynamicResource Panel}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource OnlineSetupMods}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{DynamicResource OnlineSetupAddMods}" Click="RoomSetupAddMods" />
                </Grid>
                <TextBlock Text="{DynamicResource OnlineSetupModsHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel x:Name="RoomSetupModsList" Spacing="4" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="RoomSetupCreateButton" Classes="primary" Content="{DynamicResource OnlineSetupCreate}" Click="ConfirmCreateRoom" />
              <Button Content="{DynamicResource OnlineSetupCancel}" Click="CloseRoomSetup" />
            </StackPanel>
            <TextBlock x:Name="RoomSetupStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- PROFILE: who you are to your friends, and how they get your code -->
      <ScrollViewer x:Name="ProfileView" Classes="view" IsVisible="False">
        <StackPanel Margin="34,26,34,34" Spacing="14">
          <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
              <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True" VerticalAlignment="Center" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Panel>
                  <TextBlock Text="☺" FontSize="28" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="ProfileHeroAvatar" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource ProfileEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" />
                <TextBlock x:Name="ProfileHandleText" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource ProfileHandleHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Until a pseudo exists, this is the whole page: nothing friends-related works without one. -->
          <Border x:Name="IdentityGate" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel Spacing="9">
              <TextBlock Text="{DynamicResource IdentityCreateTitle}" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="{DynamicResource IdentityCreateHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              <TextBox x:Name="IdentityNameBox" MaxLength="32" Watermark="{DynamicResource IdentityNameHint}" TextChanged="PreviewIdentity" />
              <TextBlock x:Name="IdentityPreviewText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal"><Button x:Name="CreateIdentityButton" Classes="primary" Content="{DynamicResource IdentityCreate}" IsEnabled="False" Click="CreateIdentity" /></StackPanel>
            </StackPanel>
          </Border>

          <StackPanel x:Name="IdentityBody" Spacing="14">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="9">
                <TextBlock Text="{DynamicResource ShareCodeTitle}" FontSize="18" FontWeight="Bold" />
                <TextBlock x:Name="ShareStatusText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource MyFriendCode}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="OwnFriendCodeBox" IsReadOnly="True" Watermark="{DynamicResource MyFriendCodeHint}" />
                  <Button x:Name="CopyOwnCodeButton" Grid.Column="1" Content="{DynamicResource CopyMyCode}" Classes="primary" IsEnabled="False" Click="CopyOwnFriendCode" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="9">
                <TextBlock Text="{DynamicResource PhoneTransferTitle}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource PhoneTransferHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"><Button Classes="primary" Content="{DynamicResource PhoneLinkShow}" Click="ShowPhoneQrCode" /></StackPanel>
                <TextBlock Text="{DynamicResource PhoneTransferFileTitle}" FontWeight="Bold" Margin="0,10,0,0" />
                <TextBlock x:Name="IdentityBackupHint" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" IsVisible="False" />
                <TextBox x:Name="PhoneTransferPassphraseBox" PasswordChar="•" Watermark="{DynamicResource PhoneTransferPassphrase}" />
                <TextBox x:Name="PhoneTransferConfirmBox" PasswordChar="•" Watermark="{DynamicResource PhoneTransferConfirm}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{DynamicResource PhoneTransferExport}" Click="ExportProfileForPhone" />
                  <Button Content="{DynamicResource IdentityRestore}" Click="RestoreIdentityBackup" />
                </StackPanel>
                <TextBlock x:Name="PhoneTransferStatusText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="9">
                <TextBlock Text="{DynamicResource PresenceDisplayName}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBox x:Name="PresenceNameBox" Watermark="{DynamicResource PresenceDisplayNameHint}" MaxLength="32" LostFocus="SavePseudo" />

                <TextBlock Text="{DynamicResource MyProfile}" FontWeight="Bold" Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource MyProfileHelp}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,6,0,0">
                  <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Panel>
                      <TextBlock x:Name="ProfileAvatarEmpty" Text="☺" FontSize="34" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image x:Name="ProfileAvatarImage" Stretch="UniformToFill" IsVisible="False" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{DynamicResource ProfileAvatarChoose}" Click="ChooseProfileAvatar" />
                      <Button x:Name="ClearProfileAvatarButton" Content="{DynamicResource ProfileAvatarClear}" Click="ClearProfileAvatar" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ProfileAvatarHelp}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource ProfileStatus}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBox x:Name="ProfileStatusBox" MaxLength="140" Watermark="{DynamicResource ProfileStatusHint}" LostFocus="SaveProfileText" />

                <TextBlock Text="{DynamicResource ProfilePinned}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <ComboBox x:Name="ProfilePinnedBox" HorizontalAlignment="Stretch" SelectionChanged="SavePinnedGame" />
              </StackPanel>
            </Border>
            <!-- Where the player stands in each game played, and what friends see of it. -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="9">
                <TextBlock Text="{DynamicResource RaProgressTitle}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource RaProgressHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                <TextBlock x:Name="RaProgressStatusText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
                <ItemsControl x:Name="RaProgressList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                          <!-- The game's own cover, from the library; a plain case when it has none. -->
                          <Border Width="64" Height="90" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center">
                            <Panel>
                              <TextBlock Text="🏆" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Percent}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="9" />
                            <TextBlock Grid.Row="2" Text="{Binding Counts}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Shared}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,6,0,0" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- Only for whoever still publishes to a synced folder: nobody else is offered a cloud. -->
            <Border x:Name="LegacyPresenceCard" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="9">
                <TextBlock Text="{DynamicResource PresenceLegacyTitle}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource PresenceHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />

                <!-- Our own address read back: shown only when friends are not getting what we write. -->
                <Border x:Name="AddressHealthBanner" IsVisible="False" Padding="12" CornerRadius="10" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Warning}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="AddressHealthText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{DynamicResource AddressCheckNow}" Click="CheckOwnAddressNow" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- The folders sync clients already watch here: one click instead of a hunt. -->
                <TextBlock Text="{DynamicResource SyncFoldersFound}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <ItemsControl x:Name="DetectedFoldersList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Tag="{Binding}" Click="UseDetectedFolder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DetectedFoldersEmptyText" Text="{DynamicResource SyncFoldersNone}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" IsVisible="False" />

                <TextBlock Text="{DynamicResource PresenceFolder}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox x:Name="PresenceFolderBox" LostFocus="SavePresenceText" />
                  <Button Grid.Column="1" Content="{DynamicResource PresenceBrowse}" Click="BrowsePresenceFolder" />
                  <Button Grid.Column="2" Content="{DynamicResource PresenceOpenFolder}" Click="OpenPresenceFolder" />
                </Grid>

                <!-- How to get a public link to the file, in the words of the service that holds it. -->
                <Border x:Name="ShareStepsPanel" IsVisible="False" Padding="12" CornerRadius="10" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                  <TextBlock x:Name="ShareStepsText" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{DynamicResource PresenceUrl}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBox x:Name="PresenceUrlBox" Watermark="{DynamicResource PresenceUrlHint}" LostFocus="SavePresenceText" />
                <TextBlock x:Name="PresenceUrlConversionText" Foreground="{DynamicResource Accent2}" FontSize="11" TextWrapping="Wrap" IsVisible="False" />
                <TextBlock Text="{DynamicResource PresenceUrlHelp}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal">
                  <Button x:Name="PresenceSelfTestButton" Classes="primary" Content="{DynamicResource PresenceTest}" Click="RunPresenceSelfTest" />
                  <CheckBox x:Name="PresencePublishBox" Content="{DynamicResource PresencePublish}" VerticalAlignment="Center" Margin="10,0,0,0" Checked="SaveSettings" Unchecked="SaveSettings" />
                </StackPanel>
                <TextBlock x:Name="PresenceStatusText" Foreground="{DynamicResource Accent2}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel Spacing="9">
                <TextBlock Text="{DynamicResource WhatYouShare}" FontWeight="Bold" Margin="0,10,0,0" />
                <CheckBox x:Name="ShareLibraryBox" Content="{DynamicResource ShareLibrary}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="SharePlayTimeBox" Content="{DynamicResource SharePlayTime}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="ShareCurrentGameBox" Content="{DynamicResource ShareCurrentGame}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="ShareModsBox" Content="{DynamicResource ShareMods}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="ShareProfileBox" Content="{DynamicResource ShareProfile}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="ShareAchievementsBox" Content="{DynamicResource ShareAchievements}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="LanVisibleBox" Content="{DynamicResource LanVisible}" Checked="SaveSettings" Unchecked="SaveSettings" Margin="0,8,0,0" />
                <TextBlock Text="{DynamicResource LanVisibleHelp}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource NotificationsTitle}" FontWeight="Bold" Margin="0,14,0,0" />
                <CheckBox x:Name="CloseToTrayBox" Content="{DynamicResource CloseToTray}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="NotifyOnlineBox" Content="{DynamicResource NotifyFriendsOnline}" Checked="SaveSettings" Unchecked="SaveSettings" />
                <CheckBox x:Name="AutoAwayBox" Content="{DynamicResource AutoAway}" Checked="SaveSettings" Unchecked="SaveSettings" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- CONNECTIVITY / OFFLINE STATE -->
      <Border x:Name="ConnectivityBanner" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="620" Margin="24,24,24,92" Padding="14" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="14" ZIndex="40">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Text="●" Foreground="{DynamicResource Warning}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{DynamicResource OfflineTitle}" FontWeight="Bold" />
            <TextBlock x:Name="ConnectivityText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="RetryConnectivityButton" Grid.Column="2" Content="{DynamicResource OfflineRetry}" Click="RetryConnectivityPhase7" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border x:Name="BigPictureSubnav" IsVisible="False" VerticalAlignment="Top" Height="64" Background="{DynamicResource Panel}" Padding="24,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="BigPictureSubnavTitle" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button x:Name="BigPictureKeyboardButton" Click="OpenFocusedBigPictureKeyboard" Padding="16,10" />
            <Button x:Name="BigPictureReturnButton" Click="ReturnToBigPicture" Padding="18,10" />
          </StackPanel>
        </Grid>
      </Border>
      <!-- THEME TRANSITION -->
      <Border x:Name="ThemeTransitionOverlay" IsHitTestVisible="False" Opacity="0" Background="{DynamicResource OverlayBrush}">
        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.14" /></Transitions></Border.Transitions>
      </Border>

      <!-- TOAST -->
      <controls:GameLaunchTransition x:Name="LaunchTransition" ZIndex="90" />
      <Border x:Name="ToastHost" IsVisible="False" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="390" Margin="24" Padding="16" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" /></Transitions></Border.Transitions>
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="15" /><TextBlock x:Name="ToastMessage" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="×" Click="HideToastParity" /></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
