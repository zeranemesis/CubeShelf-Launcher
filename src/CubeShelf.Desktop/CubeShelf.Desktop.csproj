<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CubeShelf</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\gamecube_logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <ProjectReference Include="..\CubeShelf.Core\CubeShelf.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="games.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Catalogs/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets\Covers\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <AvaloniaResource Include="Assets\Brand\gamecube_logo.png" />
    <AvaloniaResource Include="Assets/Logos/*.png" />
    <AvaloniaResource Include="Assets\Models\Jaquette_GameCube_3D_vierge.glb" />
  </ItemGroup>
  <Target Name="VerifyPublishedCoverFiles" AfterTargets="Publish">
    <ItemGroup>
      <_CubeShelfCover Include="Assets/Covers/**/*" />
    </ItemGroup>
    <Error Condition="!Exists('$(PublishDir)Assets/Covers/%(_CubeShelfCover.RecursiveDir)%(_CubeShelfCover.Filename)%(_CubeShelfCover.Extension)')"
           Text="Missing published cover: Assets/Covers/%(_CubeShelfCover.RecursiveDir)%(_CubeShelfCover.Filename)%(_CubeShelfCover.Extension)" />
  </Target>
</Project>
