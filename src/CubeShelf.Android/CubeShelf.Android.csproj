<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>io.github.zeranemesis.cubeshelf</ApplicationId>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>$(CubeShelfVersion)</ApplicationDisplayVersion>
    <ApplicationTitle>CubeShelf</ApplicationTitle>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.21" />
    <ProjectReference Include="../CubeShelf.Mobile/CubeShelf.Mobile.csproj" />
    <AndroidResource Include="../CubeShelf.Desktop/Assets/Brand/gamecube_logo.png" Link="Resources/drawable/icon.png" />
  </ItemGroup>
</Project>
