<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>io.github.zeranemesis.cubeshelf</ApplicationId>
    <ApplicationVersion>50</ApplicationVersion>
    <ApplicationDisplayVersion>$(CubeShelfVersion)</ApplicationDisplayVersion>
    <ApplicationTitle>DecompShelf</ApplicationTitle>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">false</AndroidEnableProfiledAot>
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <AndroidLinkMode Condition="'$(Configuration)' != 'Release'">None</AndroidLinkMode>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/CubeShelf.Assistance.Tests/AndroidOverlayProbe.cs" Link="Tests/AndroidOverlayProbe.cs" Condition="'$(Configuration)' == 'Debug'" />
    <AndroidNativeLibrary Remove="Generated/Assistance/**/*.so" />
    <AndroidJavaSource Remove="Generated/Ghostship/**/*.java" />
    <AndroidLibrary Remove="**/*.jar" />
    <AndroidLibrary Include="Generated/PartyBoard/partyboard-host.jar" Bind="false" />
    <AndroidLibrary Include="Generated/Ghostship/ghostship-host.jar" Bind="false" />
    <AndroidAsset Include="../../vendor/ghostship-android/licenses/*" Link="ghostship/licenses/%(Filename)%(Extension)" />
    <AndroidAsset Include="../../vendor/assistance/*.txt" Link="assistance/licenses/%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia.Android" Version="11.3.21" />
    <ProjectReference Include="../CubeShelf.Mobile/CubeShelf.Mobile.csproj" />
    <AndroidResource Include="../CubeShelf.Desktop/Assets/Brand/gamecube_logo.png" Link="Resources/drawable/icon.png" />
  </ItemGroup>
  <Target Name="PreparePartyBoardEngine" BeforeTargets="PrepareForBuild" DependsOnTargets="_ResolveMonoAndroidSdks">
    <PropertyGroup>
      <PartyBoardPython Condition="'$(OS)' == 'Windows_NT'">python</PartyBoardPython>
      <PartyBoardPython Condition="'$(PartyBoardPython)' == ''">python3</PartyBoardPython>
    </PropertyGroup>
    <Exec Command="&quot;$(PartyBoardPython)&quot; &quot;$(MSBuildProjectDirectory)/../../eng/prepare-partyboard-android.py&quot;" Condition="'$(RuntimeIdentifier)' == 'android-arm64'" />
    <Exec Command="&quot;$(PartyBoardPython)&quot; &quot;$(MSBuildProjectDirectory)/../../eng/compile-partyboard-host.py&quot; --java-home &quot;$(_JavaSdkDirectory).&quot; --sdk &quot;$(_AndroidSdkDirectory).&quot;" />
    <ItemGroup>
      <AndroidNativeLibrary Remove="Generated/PartyBoard/arm64-v8a/*.so" />
      <AndroidNativeLibrary Include="Generated/PartyBoard/arm64-v8a/*.so" Abi="arm64-v8a" Condition="'$(RuntimeIdentifier)' == 'android-arm64'" />
    </ItemGroup>
  </Target>
  <Target Name="PrepareGhostshipEngine" BeforeTargets="PrepareForBuild" DependsOnTargets="_ResolveMonoAndroidSdks">
    <PropertyGroup>
      <GhostshipPython Condition="'$(OS)' == 'Windows_NT'">python</GhostshipPython>
      <GhostshipPython Condition="'$(GhostshipPython)' == ''">python3</GhostshipPython>
    </PropertyGroup>
    <Exec Command="&quot;$(GhostshipPython)&quot; &quot;$(MSBuildProjectDirectory)/../../eng/prepare-ghostship-android.py&quot; --java-home &quot;$(_JavaSdkDirectory).&quot; --sdk &quot;$(_AndroidSdkDirectory).&quot;" />
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'android-arm64'">
      <AndroidNativeLibrary Remove="Generated/Ghostship/arm64-v8a/*.so" />
      <AndroidNativeLibrary Include="Generated/Ghostship/arm64-v8a/*.so" Abi="arm64-v8a" />
      <AndroidAsset Remove="Generated/Ghostship/assets/**/*" />
      <AndroidAsset Include="Generated/Ghostship/assets/ghostship/gamedata.zip" Link="ghostship/gamedata.zip" />
      <AndroidAsset Include="Generated/Ghostship/assets/ghostship/gamedata.version" Link="ghostship/gamedata.version" />
      <AndroidAsset Include="Generated/Ghostship/assets/ghostship/gamecontrollerdb.txt" Link="ghostship/gamecontrollerdb.txt" />
      <AndroidAsset Include="Generated/Ghostship/assets/ghostship/LLVM-NOTICE.txt" Link="ghostship/LLVM-NOTICE.txt" />
    </ItemGroup>
  </Target>
  <Target Name="PrepareLocalAssistant" BeforeTargets="PrepareForBuild" DependsOnTargets="_ResolveMonoAndroidSdks">
    <PropertyGroup>
      <AssistantPython Condition="'$(OS)' == 'Windows_NT'">python</AssistantPython>
      <AssistantPython Condition="'$(AssistantPython)' == ''">python3</AssistantPython>
      <AssistantAbi Condition="'$(RuntimeIdentifier)' == 'android-x64'">x86_64</AssistantAbi>
      <AssistantAbi Condition="'$(AssistantAbi)' == ''">arm64-v8a</AssistantAbi>
    </PropertyGroup>
    <Exec Command="&quot;$(AssistantPython)&quot; &quot;$(MSBuildProjectDirectory)/../../eng/prepare-assistance.py&quot; --android-sdk &quot;$(_AndroidSdkDirectory).&quot; --abi $(AssistantAbi)" />
    <ItemGroup>
      <AndroidNativeLibrary Remove="Generated/Assistance/**/*.so" />
      <AndroidNativeLibrary Include="Generated/Assistance/$(AssistantAbi)/libdecompshelf_ai.so" Abi="$(AssistantAbi)" />
    </ItemGroup>
  </Target>
</Project>


